<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Proxy API requests to the backend server -->
        <rule name="API Proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://asifghafoor-001-site12.ntempurl.com/api/{R:1}" />
        </rule>
        <!-- Handle SPA routes by returning index.html -->
        <rule name="SPA Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Add CORS" preCondition="IsAPI">
          <match serverVariable="RESPONSE_Access-Control-Allow-Origin" pattern=".*" />
          <action type="Rewrite" value="*" />
        </rule>
        <rule name="Add CORS Methods" preCondition="IsAPI">
          <match serverVariable="RESPONSE_Access-Control-Allow-Methods" pattern=".*" />
          <action type="Rewrite" value="GET, POST, OPTIONS, PUT, DELETE" />
        </rule>
        <rule name="Add CORS Headers" preCondition="IsAPI">
          <match serverVariable="RESPONSE_Access-Control-Allow-Headers" pattern=".*" />
          <action type="Rewrite" value="Content-Type, Authorization, X-Tenant-ID" />
        </rule>
        <rule name="Add CORS Credentials" preCondition="IsAPI">
          <match serverVariable="RESPONSE_Access-Control-Allow-Credentials" pattern=".*" />
          <action type="Rewrite" value="true" />
        </rule>
        <preConditions>
          <preCondition name="IsAPI">
            <add input="{URL}" pattern="^/api/.*" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, OPTIONS, PUT, DELETE" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Tenant-ID" />
        <add name="Access-Control-Allow-Credentials" value="true" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration> 